# Kubernetes Deployment Environment Variables
# Copy this file to .env.k8s and fill in the values

# ===========================================
# Application Settings
# ===========================================
APP_ENV=development
APP_VERSION=1.0.0
LOG_LEVEL=INFO
LOG_FORMAT=json

# ===========================================
# Backend Settings
# ===========================================
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
BACKEND_WORKERS=2

# ===========================================
# Frontend Settings
# ===========================================
NEXT_PUBLIC_API_URL=http://todo-backend:8000
NEXT_PUBLIC_APP_VERSION=1.0.0

# ===========================================
# Database Settings
# ===========================================
POSTGRES_HOST=todo-postgres
POSTGRES_PORT=5432
POSTGRES_DB=todo_db
POSTGRES_USER=todo_user
POSTGRES_PASSWORD=changeme_in_production

# Full database URL (constructed from above)
DATABASE_URL=postgresql://todo_user:changeme_in_production@todo-postgres:5432/todo_db

# ===========================================
# Authentication (Better Auth)
# ===========================================
BETTER_AUTH_SECRET=changeme_32_character_secret_key
BETTER_AUTH_URL=http://localhost:3000
JWT_SECRET=changeme_jwt_secret_key

# ===========================================
# AI Tools (Optional)
# ===========================================
# Required for kubectl-ai
OPENAI_API_KEY=sk-your-openai-api-key

# ===========================================
# Kubernetes Specific
# ===========================================
NAMESPACE=default
RELEASE_NAME=todo-app
IMAGE_TAG=latest
IMAGE_PULL_POLICY=IfNotPresent

# ===========================================
# Resource Limits (for Helm values)
# ===========================================
BACKEND_CPU_REQUEST=100m
BACKEND_CPU_LIMIT=500m
BACKEND_MEMORY_REQUEST=128Mi
BACKEND_MEMORY_LIMIT=512Mi

FRONTEND_CPU_REQUEST=100m
FRONTEND_CPU_LIMIT=500m
FRONTEND_MEMORY_REQUEST=128Mi
FRONTEND_MEMORY_LIMIT=512Mi

POSTGRES_CPU_REQUEST=100m
POSTGRES_CPU_LIMIT=500m
POSTGRES_MEMORY_REQUEST=256Mi
POSTGRES_MEMORY_LIMIT=1Gi
