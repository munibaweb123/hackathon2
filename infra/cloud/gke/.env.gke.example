# GKE Deployment Environment Variables
# Copy this file to .env.gke and fill in your values
# Usage: source .env.gke

# Required: GCP Project ID
export GCP_PROJECT_ID="your-gcp-project-id"

# Required: Your domain for the application
export DOMAIN="todo.yourdomain.com"

# Required: Database password (use a strong password)
export DB_PASSWORD="your-secure-database-password"

# Optional: GCP Region (default: us-central1)
export GCP_REGION="us-central1"

# Optional: Cluster name (default: todo-app-cluster)
export CLUSTER_NAME="todo-app-cluster"

# Optional: Cluster type - "autopilot" or "standard" (default: autopilot)
export CLUSTER_TYPE="autopilot"

# Optional: Cloud SQL instance name (default: todo-postgres)
export CLOUD_SQL_INSTANCE="todo-postgres"

# Optional: Database tier (default: db-g1-small)
# Options: db-f1-micro (dev), db-g1-small (prod), db-custom-*
export DB_TIER="db-g1-small"

# Optional: Database name (default: todo_app)
export DB_NAME="todo_app"

# Optional: Database user (default: todo_user)
export DB_USER="todo_user"

# Optional: Artifact Registry repository name (default: todo-app)
export REPO_NAME="todo-app"

# Optional: Image tag (default: latest)
export IMAGE_TAG="latest"

# Optional: Kubernetes namespace (default: todo-app)
export NAMESPACE="todo-app"

# Optional: Helm release name (default: todo-app)
export RELEASE_NAME="todo-app"

# Application Secrets
# -------------------

# Required: Better Auth secret for JWT signing
export BETTER_AUTH_SECRET="generate-a-32-character-secret-key"

# Optional: OpenAI API key for chatbot features
export OPENAI_API_KEY=""

# Optional: Resend API key for email notifications
export RESEND_API_KEY=""
