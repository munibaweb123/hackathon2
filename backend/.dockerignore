# ===================================
# Docker Ignore - Backend
# Excludes files from Docker build context
# ===================================

# Git
.git/
.gitignore
.gitattributes

# Docker (avoid recursive copies)
Dockerfile*
docker-compose*.yml
.docker/

# Documentation
*.md
README*
docs/
specs/
history/
.specify/

# IDE and editors
.vscode/
.idea/
*.swp
*.swo
*~

# Python bytecode and cache
__pycache__/
*.py[cod]
*$py.class
.Python
*.egg-info/
.eggs/
dist/
build/
.mypy_cache/
.tox/

# Virtual environments
.venv/
venv/
env/
ENV/

# Testing
.pytest_cache/
.coverage
htmlcov/
*.cover
.hypothesis/
tests/
**/tests/
test_*.py
*_test.py
coverage/

# Environment files (secrets)
.env
.env.*
!.env.example

# Logs
*.log
logs/

# OS files
.DS_Store
Thumbs.db

# CI/CD
.github/
.gitlab-ci.yml
.travis.yml
Jenkinsfile

# Kubernetes/Helm (not needed in app image)
infra/
*.yaml
!requirements.txt

# Temp files
*.tmp
*.temp
*.bak
tmp/
temp/

# Database files
*.db
*.sqlite
*.sqlite3

# Large/unnecessary files
*.so
